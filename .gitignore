# ==========================================
# MetaHuman - Universal .gitignore
# ==========================================

# --- Sistem de Operare ---
.DS_Store
Thumbs.db
*~
*.swp

# --- IDE-uri (Visual Studio, VS Code, IntelliJ, Android Studio) ---
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
.vscode/

# --- Backend (ASP.NET Core / C#) ---
/backend/**/bin/
/backend/**/obj/
#/backend/appsettings.Development.json
/backend/appsettings.Production.json
*.log

# --- Frontend (Vue.js / Node.js) ---
/frontend/node_modules/
/frontend/dist/
/frontend/.env
/frontend/.env.local
/frontend/npm-debug.log*
/frontend/yarn-error.log*

# --- Mobile (Android) ---
/mobile/**/build/
/mobile/.gradle/
/mobile/local.properties
/mobile/**/*.apk
/mobile/**/*.aab
/mobile/captures/

# --- Hardware (Arduino) ---
/hardware/build/
/hardware/**/*.hex
/hardware/**/*.elf
/hardware/**/*.bin

# --- Altele / Securitate ---
*.pem
*.key
*.cert
# (Nu comitem cheile de la Wireguard sau parolele bazei de date PostgreSQL!)
